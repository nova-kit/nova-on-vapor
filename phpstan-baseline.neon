parameters:
	ignoreErrors:
		-
			message: '#^Call to function method_exists\(\) with ''Laravel\\\\Prompts\\\\Prompt'' and ''interactive'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Console/UserCommand.php

		-
			message: '#^PHPDoc tag @var with type array\|\(Closure\)\|Laravel\\Prompts\\Prompt is not subtype of native type array\|Laravel\\Prompts\\Prompt\.$#'
			identifier: varTag.nativeType
			count: 1
			path: src/Console/Util/CreateUserOptions.php

		-
			message: '#^Call to an undefined method Illuminate\\Contracts\\Filesystem\\Filesystem\:\:temporaryUrl\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Fields/VaporFileMixins.php

		-
			message: '#^Call to an undefined method Illuminate\\Contracts\\Filesystem\\Filesystem\:\:download\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Http/Controllers/DownloadsController.php

		-
			message: '#^Call to an undefined method Illuminate\\Contracts\\Foundation\\Application\:\:configurationIsCached\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/LaravelServiceProvider.php

		-
			message: '#^Call to an undefined method Illuminate\\Contracts\\Foundation\\Application\:\:routesAreCached\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/LaravelServiceProvider.php
